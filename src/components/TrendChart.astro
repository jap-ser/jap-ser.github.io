---
// 四半期推移のシンプルなインラインSVGグラフ（外部JSなし）
// 棒＝取引件数（全種別合計）、折れ線＝土地の坪単価中央値（万円/坪）
import type { QuarterRow } from '../lib/data';

interface Props { rows: QuarterRow[]; title?: string }
const { rows, title = '四半期ごとの推移（直近3年）' } = Astro.props;

const W = 640, H = 220, padL = 44, padR = 44, padT = 16, padB = 34;
const iw = W - padL - padR, ih = H - padT - padB;
const n = rows.length;
const counts = rows.map((r) => r.land.count + r.house.count + r.condo.count);
const maxCount = Math.max(1, ...counts);
const line = rows.map((r) => r.land.medianTsubo);
const lineVals = line.filter((v): v is number => v != null);
const maxLine = lineVals.length ? Math.max(...lineVals) * 1.15 : 1;
const minLine = lineVals.length ? Math.min(...lineVals) * 0.85 : 0;
const x = (i: number) => padL + (iw / n) * i + (iw / n) / 2;
const bw = Math.max(6, (iw / n) * 0.55);
const yC = (c: number) => padT + ih - (c / maxCount) * ih;
const yL = (v: number) => padT + ih - ((v - minLine) / Math.max(1e-6, maxLine - minLine)) * ih;
const points = rows.map((r, i) => (r.land.medianTsubo != null ? `${x(i).toFixed(1)},${yL(r.land.medianTsubo).toFixed(1)}` : null));
const segments: string[] = [];
let cur: string[] = [];
for (const p of points) { if (p) cur.push(p); else { if (cur.length > 1) segments.push(cur.join(' ')); cur = []; } }
if (cur.length > 1) segments.push(cur.join(' '));
const hasLine = lineVals.length > 0;
const total = counts.reduce((a, b) => a + b, 0);
---
{total > 0 && (
  <figure style="margin:16px 0">
    <figcaption class="small muted" style="margin-bottom:4px">{title}：棒＝取引件数（全種別）{hasLine && '、線＝土地の坪単価中央値（万円/坪）'}</figcaption>
    <div class="table-wrap">
      <svg viewBox={`0 0 ${W} ${H}`} width="100%" style="min-width:480px;max-width:100%;display:block" role="img" aria-label={`${title}。件数と土地坪単価の推移`}>
        <line x1={padL} y1={padT + ih} x2={W - padR} y2={padT + ih} stroke="#c9d1d8" />
        <text x={padL - 6} y={padT + 4} font-size="10" text-anchor="end" fill="#5b6770">{maxCount}件</text>
        <text x={padL - 6} y={padT + ih} font-size="10" text-anchor="end" fill="#5b6770">0</text>
        {hasLine && <text x={W - padR + 6} y={padT + 4} font-size="10" fill="#c8572a">{maxLine.toFixed(0)}</text>}
        {hasLine && <text x={W - padR + 6} y={padT + ih} font-size="10" fill="#c8572a">{minLine.toFixed(0)}</text>}
        {rows.map((r, i) => (
          <g>
            <rect x={x(i) - bw / 2} y={yC(counts[i])} width={bw} height={padT + ih - yC(counts[i])} fill="#9db7cb" rx="1.5">
              <title>{r.label}：{counts[i]}件</title>
            </rect>
            {(i % 2 === n % 2) && <text x={x(i)} y={H - 12} font-size="10" text-anchor="middle" fill="#5b6770">{r.label}</text>}
          </g>
        ))}
        {segments.map((s) => <polyline points={s} fill="none" stroke="#c8572a" stroke-width="2" />)}
        {rows.map((r, i) => r.land.medianTsubo != null && (
          <circle cx={x(i)} cy={yL(r.land.medianTsubo)} r="3" fill="#c8572a"><title>{r.label}：土地 {r.land.medianTsubo}万円/坪（{r.land.count}件）</title></circle>
        ))}
      </svg>
    </div>
  </figure>
)}
