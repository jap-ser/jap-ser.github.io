---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { breadcrumbLd } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getCollection('guide');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const crumbs = [{ name: 'トップ', href: '/' }, { name: '状況別ガイド', href: '/guide/' }, { name: g.data.title, href: `/guide/${g.id}/` }];
const others = (await getCollection('guide')).filter((x) => x.id !== g.id).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---
<Base title={g.data.title} description={g.data.description} path={`/guide/${g.id}/`} jsonLd={[breadcrumbLd(crumbs)]} noindex={!g.data.reviewed}>
  <Breadcrumb items={crumbs} />
  <article class="prose">
    <h1>{g.data.title}</h1>
    <p class="note">更新日：{g.data.updated}　執筆：有限会社ジャパンサービス</p>
    <Content />
  </article>
  <CtaBlock areaName="金沢・石川" />
  <h2>関連するガイド</h2>
  <div class="chips">{others.map((o) => <a href={`/guide/${o.id}/`}>{o.data.title}</a>)}</div>
</Base>
