---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { breadcrumbLd, faqLd } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getCollection('guide');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const crumbs = [{ name: 'トップ', href: '/' }, { name: '状況別ガイド', href: '/guide/' }, { name: g.data.title, href: `/guide/${g.id}/` }];
const others = (await getCollection('guide')).filter((x) => x.id !== g.id).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
// 本文の「**Q. 質問**」「A. 回答」の組を FAQPage 構造化データにする（リンクや強調記号は外す）
const plain = (s: string) => s.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/\*\*/g, '').trim();
const qa = [...(g.body ?? '').matchAll(/\*\*Q\.\s*([^\n]+?)\*\*\s*\r?\nA\.\s*([^\n]+)/g)].map((m) => ({ q: plain(m[1]), a: plain(m[2]) }));
const jsonLd = qa.length ? [breadcrumbLd(crumbs), faqLd(qa)] : [breadcrumbLd(crumbs)];
---
<Base title={g.data.title} description={g.data.description} path={`/guide/${g.id}/`} jsonLd={jsonLd} noindex={!g.data.reviewed}>
  <Breadcrumb items={crumbs} />
  <article class="prose">
    <h1>{g.data.title}</h1>
    <p class="note">更新日：{g.data.updated}　執筆：有限会社ジャパンサービス</p>
    <Content />
  </article>
  <CtaBlock areaName="金沢・石川" />
  <h2>関連するガイド</h2>
  <div class="chips">{others.map((o) => <a href={`/guide/${o.id}/`}>{o.data.title}</a>)}</div>
</Base>
