---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { breadcrumbLd, faqLd } from '../lib/seo';
const crumbs = [{ name: 'トップ', href: '/' }, { name: 'よくあるご質問', href: '/faq/' }];
const qa = [
  { q: '査定や相談にお金はかかりますか？', a: 'かかりません。相場の説明、概算の提示、現地確認まで無料です。売却を決めていない段階のご相談も承ります。' },
  { q: 'サイトの相場と、実際の査定額は同じですか？', a: '同じではありません。サイトの相場は町名単位の取引の中央値で、実際の査定は面積・形状・接道・建物の状態・時期などの個別要因を反映します。相場は「だいたいの目安」としてご覧ください。' },
  { q: '買取価格は相場の何割くらいですか？', a: '一律の割合はお伝えしていません。再販にかかる費用や期間が物件ごとに異なるためです。査定・物件確認のうえで、買取価格と、参考として仲介の場合の見込みを並べてご提示します。' },
  { q: '家財や荷物が残ったままでも売れますか？', a: '当社買取の場合は、残置物があるままでご相談いただけます。仲介の場合は原則として引渡しまでに片付けが必要ですが、方法は一緒に考えます。' },
  { q: '遠方に住んでいて現地に行けません。', a: '書類のやり取りや契約は郵送・オンラインを組み合わせて進められます。現地の確認は当社で行い、写真や動画でご報告します。詳しくは「遠方からの売却」のガイドをご覧ください。' },
  { q: '相続の名義変更（相続登記）がまだです。売れますか？', a: '売却には相続登記が必要です。司法書士のご紹介を含め、順番と必要書類をご案内します。2024年4月から相続登記は義務化されています。' },
  { q: '近所に知られずに売りたいのですが。', a: '当社買取であれば広告や内覧がないため、周囲に知られにくく進められます。仲介でも広告方法を限定する進め方はご相談いただけます。' },
  { q: '古い家が建っています。解体してから売るべきですか？', a: '一概には言えません。解体費と、更地にした場合の固定資産税の増加、買主層の違いを比べて判断します。古家付きのまま売る、当社が買い取って解体するなど、選択肢を並べてご説明します。' },
  { q: '対応エリアはどこですか？', a: '金沢市・野々市市・白山市・津幡町・かほく市・能美市・小松市・羽咋市を中心に対応しています。周辺エリアもご相談ください。' },
  { q: '相場データはどこから来ていますか？', a: '国土交通省「不動産情報ライブラリ」の不動産取引価格情報（取引当事者へのアンケートに基づく取引価格と、レインズの成約価格）を、当社が町名・種別ごとに集計しています。四半期ごとの公表に合わせて毎月更新しています。' },
];
const desc = '不動産の売却・買取に関するよくあるご質問。査定は無料か、買取価格の決まり方、残置物、遠方からの売却、相続登記、相場データの出典などにお答えします。';
---
<Base title="よくあるご質問" description={desc} path="/faq/" jsonLd={[breadcrumbLd(crumbs), faqLd(qa)]}>
  <Breadcrumb items={crumbs} />
  <h1>よくあるご質問</h1>
  <div class="faq">
    {qa.map(({ q, a }) => (
      <details><summary>{q}</summary><p>{a}</p></details>
    ))}
  </div>
  <CtaBlock areaName="金沢・石川" />
</Base>
