---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LeadForm from '../components/LeadForm.astro';
import { COMPANY, CITIES } from '../config/site';
import { breadcrumbLd } from '../lib/seo';
const crumbs = [{ name: 'トップ', href: '/' }, { name: 'ご相談・査定フォーム', href: '/contact/' }];
const desc = '不動産の売却・買取のご相談はフォーム・LINE・お電話から。所在地（町名まで）・種別・おおよその面積が分かれば、仲介と買取の両方の目安をお伝えします。金沢市のジャパンサービス。';
---
<Base title="ご相談・査定フォーム" description={desc} path="/contact/" jsonLd={[breadcrumbLd(crumbs)]}>
  <Breadcrumb items={crumbs} />
  <h1>ご相談・査定フォーム（無料）</h1>
  <p class="lead">売るかどうか決めていなくても大丈夫です。所在地（町名まで）・種別・おおよその面積が分かれば、相場データをもとに仲介と買取の両方の目安をお伝えします。営業時間内（{COMPANY.hours}）に担当からご連絡します。</p>

  <div class="contact-grid">
    <div>
      <LeadForm variant="full" title="査定・ご相談フォーム" />
    </div>
    <aside>
      <div class="card">
        <img src="/img/staff-consult.jpg" alt="" loading="lazy" style="width:100%;height:220px;object-fit:cover;border-radius:10px;margin-bottom:10px" />
        <h3>LINEで相談（いちばん早い）</h3>
        <p class="small">写真や登記情報の画像もそのまま送れます。返信は営業時間内に行います。</p>
        <a class="btn line" href={COMPANY.line} rel="noopener" style="display:block">LINEで友だち追加して相談</a>
        <h3>お電話</h3>
        <p class="small">{COMPANY.hours}。担当が不在の場合は折り返します。</p>
        <a class="btn tel" href={COMPANY.telLink} style="display:block">{COMPANY.tel}</a>
        <p class="note" style="margin-top:12px">写真はイメージです</p>
      </div>
      <div class="card" style="margin-top:14px">
        <h3>対応エリア</h3>
        <div class="chips">{CITIES.map((c) => <a href={`/${c.key}/`}>{c.name}</a>)}</div>
        <p class="small muted" style="margin:8px 0 0">周辺エリアもご相談ください。</p>
      </div>
    </aside>
  </div>
</Base>

<style>
  .contact-grid { display: grid; gap: 20px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 880px) { .contact-grid { grid-template-columns: 1.2fr .8fr; } }
</style>
