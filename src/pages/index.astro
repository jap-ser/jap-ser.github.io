---
import Base from '../layouts/Base.astro';
import CtaBlock from '../components/CtaBlock.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, COMPANY, CITIES } from '../config/site';
import { agg, cityList, townsWithPage, tsubo, yen, results } from '../lib/data';

const cities = cityList();
const kanazawa = agg.cities.kanazawa;
const totalPages = cities.reduce((a, c) => a + c.pageCount, 0);
const desc = SITE.description;
---
<Base title="トップ" description={desc} path="/" wide>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="hero-tag">金沢市・石川県内 8市町 / {totalPages}町名の相場を毎月更新</span>
        <h1>相場を知ってから、<br />「仲介」か「買取」かを選ぶ。</h1>
        <p>国土交通省が公表する実際の取引データを町名ごとに集計しました。相場を確かめたうえで、時間をかけて高く売る仲介と、早く手間なく終える当社買取の両方の見込みを並べてご提案します。</p>
        <div class="hero-photo">
          <img src="/img/staff-consult.jpg" alt="" width="328" height="400" loading="eager" />
          <div>
            <b>{COMPANY.name}</b>
            <span>{COMPANY.license}｜創業1989年｜金沢市西都</span>
            <div class="btns" style="margin:10px 0 0">
              <a class="btn line" href={COMPANY.line} rel="noopener">LINEで相談</a>
              <a class="btn tel" href={COMPANY.telLink}>{COMPANY.tel}</a>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-form">
        <LeadForm variant="compact" title="まずは相場と買取の目安を確認（無料）" />
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="kpi">
      <div><b>{cities.length}市町</b><span>対象エリア</span></div>
      <div><b>{totalPages}町名</b><span>町名別の相場ページ</span></div>
      <div><b>{agg.totalRecords.toLocaleString('ja-JP')}件</b><span>集計した取引データ（直近5年）</span></div>
      <div><b>{agg.latestPeriodLabel}</b><span>最新データ期</span></div>
    </div>

    <h2 id="areas">エリアから相場を見る</h2>
    <div class="grid">
      {cities.map((c) => (
        <div class="card">
          <h3><a href={`/${c.key}/`}>{c.name}の不動産相場 →</a></h3>
          <div class="kv">
            土地 中央値：{c.summary.land.y3.count ? tsubo(c.summary.land.y3.medianTsubo) : '—'}<br />
            戸建 中央値：{c.summary.house.y3.count ? yen(c.summary.house.y3.medianPrice) : '—'}<br />
            町名ページ：{c.pageCount}件
          </div>
        </div>
      ))}
    </div>
    <p class="note">中央値は直近3年（{agg.windowY3}）。詳しい表と推移は各エリアのページへ。</p>

    {kanazawa && kanazawa.pageCount > 0 && (
      <>
        <h3>金沢市で取引の多い町名</h3>
        <div class="chips">
          {townsWithPage(kanazawa).slice(0, 24).map((t) => <a href={`/kanazawa/${t.slug}/`}>{t.name}</a>)}
        </div>
        <p class="small"><a href="/kanazawa/">金沢市のすべての町名を見る →</a></p>
      </>
    )}

    <h2 class="center">こんな不安、ありませんか</h2>
    <div class="tiles">
      <div class="tile"><img src="/img/person-think.jpg" alt="" loading="lazy" /><div><b>いくらで売れるのか<i>見当がつかない</i></b><p>町名ページの実データで目安をつかめます。そのうえで当社が仲介・買取の両方の見込みを出します。</p></div></div>
      <div class="tile"><img src="/img/house.jpg" alt="" loading="lazy" /><div><b>片付ける余裕がない <i>→ そのままでOK</i></b><p>家具・荷物・庭木・古い建物、当社買取なら現状のままご相談いただけます。</p></div></div>
      <div class="tile"><img src="/img/kanazawa-street.jpg" alt="" loading="lazy" /><div><b>周囲に知られたくない <i>→ 広告なし</i></b><p>当社買取は広告や内覧がないので、近所に知られずに進められます。</p></div></div>
      <div class="tile"><img src="/img/person-outdoor.jpg" alt="" loading="lazy" /><div><b>相続・住み替え・遠方 <i>→ 順番から一緒に</i></b><p>相続登記や税金の特例、先に売るか買うか。状況別ガイドと担当が順番を整理します。</p></div></div>
    </div>
    <p class="photo-note">写真はイメージです</p>

    <h2>こんなときにご相談ください</h2>
    <div class="grid">
      <div class="card"><h3><a href="/guide/souzoku/">相続した家・土地を売りたい</a></h3><div class="kv">名義変更や税金の順番、空き家のままにしないための進め方</div></div>
      <div class="card"><h3><a href="/guide/akiya/">空き家を持て余している</a></h3><div class="kv">管理の負担、固定資産税、そのまま売れるかどうか</div></div>
      <div class="card"><h3><a href="/guide/sumikae/">住み替えたい</a></h3><div class="kv">先に売るか先に買うか、資金のつなぎ方</div></div>
      <div class="card"><h3><a href="/guide/enpou/">遠方に住んでいて動けない</a></h3><div class="kv">現地に来なくても進められる方法</div></div>
      <div class="card"><h3><a href="/guide/loan-zandaka/">住宅ローンが残っている</a></h3><div class="kv">残債と売却額の関係、金融機関との調整</div></div>
      <div class="card"><h3><a href="/guide/">その他の状況別ガイド →</a></h3><div class="kv">離婚・施設入所・土地の分け方・古い家の扱い・費用と税金</div></div>
    </div>

    <h2>仲介と当社買取、どちらが合うか</h2>
    <div class="compare">
      <div class="card">
        <h3>仲介（時間をかけて高く）</h3>
        <ul>
          <li>市場で買主を探すので、相場に近い価格を狙える</li>
          <li>売れるまでの期間は読みにくい（数か月〜）</li>
          <li>内覧・片付け・修繕が必要。成約時に仲介手数料</li>
        </ul>
      </div>
      <div class="card hi">
        <h3>当社買取（早く・手間なく）</h3>
        <ul>
          <li>価格は査定・物件確認のうえでご提示。相場より低くなるのが一般的</li>
          <li>買主探しが不要で、引渡し時期を合わせやすい</li>
          <li>現状のまま・家財が残っていても相談可（仲介手数料は仲介と同様にかかります）</li>
        </ul>
      </div>
    </div>
    <p><a href="/kaitori/">仲介と買取の違いを詳しく見る →</a></p>

    <h2>当社について</h2>
    <div class="aside-photo"><img src="/img/staff-desk.jpg" alt="" loading="lazy" /><small>写真はイメージです</small></div>
    <p>{COMPANY.name}は{COMPANY.founded}設立、金沢市西都で30年以上、売買仲介と自社買取・再販、賃貸管理を続けてきた地元の不動産会社です。免許は{COMPANY.license}（更新9回目）。代表の{COMPANY.rep}が査定からお引渡しまで責任をもって担当します。</p>
    <p><a href="/company/">会社概要・代表紹介 →</a>　<a href="/results/">最近の実績記録 →</a>{results.length === 0 && <span class="note">（実績記録は準備中）</span>}</p>
    <div style="clear:both"></div>

    <CtaBlock areaName="金沢・石川" />

    <h2>相場データについて</h2>
    <p class="small">本サイトの相場は、国土交通省「不動産情報ライブラリ」の不動産取引価格情報（取引当事者へのアンケートに基づく取引価格、およびレインズの成約価格）を、当社が町名・種別ごとに集計したものです。個々の取引が特定できないよう町名単位までの集計とし、中央値を代表値としています。実際の売却価格は、面積・形状・接道・建物の状態・時期などの個別要因で変わります。詳しくは各ページの注記をご覧ください。</p>
  </div>
</Base>

<style>
  .hero { background: linear-gradient(135deg, #1d3348 0%, #2f6f5e 100%); color: #fff; padding: 36px 0 40px; margin-bottom: 26px; }
  .hero-grid { display: grid; gap: 24px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr .85fr; gap: 36px; } }
  .hero-tag { display: inline-block; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.3); border-radius: 999px; padding: 4px 12px; font-size: .78rem; margin-bottom: 14px; }
  .hero h1 { color: #fff; font-size: 2rem; line-height: 1.35; margin: 0 0 12px; }
  .hero p { font-size: .98rem; line-height: 1.85; color: #e6eeea; max-width: 34em; }
  .hero-photo { display: flex; gap: 16px; align-items: center; margin-top: 18px; }
  .hero-photo img { width: 120px; height: 146px; object-fit: cover; border-radius: 14px; box-shadow: 0 10px 28px rgba(0,0,0,.3); }
  .hero-photo b { display: block; font-family: var(--serif); font-size: 1.05rem; }
  .hero-photo span { font-size: .78rem; color: #cfe0d8; }
  .hero-photo .btn.tel { background: #fff; color: var(--ink); border-color: #fff; }
  @media (max-width: 719px) { .hero { padding: 26px 0 28px; } .hero h1 { font-size: 1.5rem; } .hero-photo img { width: 96px; height: 116px; } }
</style>
