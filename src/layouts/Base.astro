---
import { SITE, COMPANY, ANALYTICS, CITIES } from '../config/site';
import { isSample, agg } from '../lib/data';
import ExitNudge from '../components/ExitNudge.astro';

interface Props {
  title: string;
  description: string;
  path: string;              // 例: '/kanazawa/西都/'
  jsonLd?: object[];         // 追加の構造化データ
  noindex?: boolean;
  wide?: boolean;            // トップなど、ヒーローを全幅で使うページ
}
const { title, description, path, jsonLd = [], noindex = false, wide = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const fullTitle = path === '/' ? SITE.name : `${title} | ${SITE.shortName}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: COMPANY.name,
  url: SITE.url,
  telephone: '+81-76-267-8552',
  address: { '@type': 'PostalAddress', addressCountry: 'JP', addressRegion: '石川県', addressLocality: '金沢市', streetAddress: '西都2丁目162番地' },
  openingHours: 'Mo-Fr 09:00-18:00',
  founder: { '@type': 'Person', name: COMPANY.rep },
  sameAs: [COMPANY.website],
  areaServed: CITIES.map((c) => ({ '@type': 'City', name: c.name })),
};
---
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@600;700&family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.shortName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/img/kanazawa-city.jpg', SITE.url).href} />
  <meta property="og:locale" content={SITE.locale} />
  <meta name="twitter:card" content="summary" />
  {ANALYTICS.searchConsoleMeta && <meta name="google-site-verification" content={ANALYTICS.searchConsoleMeta} />}
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  {ANALYTICS.ga4Id && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4Id}`}></script>
      <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${ANALYTICS.ga4Id}');`} />
    </>
  )}
  {/* 流入経路の控え。最初に開いたページの参照元と入口URLをタブ内に記憶し、フォーム送信時に備考へ添える（GA4が拾えない場合の保険） */}
  <script is:inline>try{var s=sessionStorage;if(!s.getItem('js_ref')){s.setItem('js_ref',(document.referrer||'(直接・不明)')+' → '+location.href)}}catch(e){}</script>
  <style is:global>
    :root {
      --ink: #1d3348; --brand: #2f6f5e; --brand-deep: #235448; --amber: #c8862c; --cta: #ea5a2a; --cta-deep: #cf4717;
      --line-green: #06c755; --line-deep: #05a648; --paper: #ffffff; --mist: #f2f6f3; --sand: #fbf7ef; --rule: #d9e2dd;
      --muted: #5f6f68; --text: #26332e; --max: 1040px;
      --serif: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
      --sans: "Noto Sans JP", "Hiragino Sans", "Yu Gothic UI", Meiryo, system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    body { margin: 0; font-family: var(--sans); color: var(--text); background: var(--paper); line-height: 1.8; font-size: 16px; }
    a { color: var(--brand); }
    img { max-width: 100%; height: auto; display: block; }
    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 16px; }
    /* header */
    header.site { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.96); backdrop-filter: blur(6px); border-bottom: 1px solid var(--rule); }
    header.site .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding-block: 8px; }
    .brand { font-family: var(--serif); font-weight: 700; text-decoration: none; color: var(--ink); font-size: 1.05rem; line-height: 1.25; }
    .brand small { display: block; font-family: var(--sans); font-weight: 400; color: var(--muted); font-size: .72rem; letter-spacing: .02em; }
    .head-right { display: flex; align-items: center; gap: 12px; }
    .head-tel { text-align: right; line-height: 1.2; text-decoration: none; color: var(--ink); }
    .head-tel b { font-size: 1.15rem; letter-spacing: .02em; }
    .head-tel small { display: block; font-size: .68rem; color: var(--muted); }
    .head-cta { background: var(--line-green); color: #fff; text-decoration: none; font-weight: 700; font-size: .85rem; padding: 9px 16px; border-radius: 999px; white-space: nowrap; }
    .head-cta:hover { background: var(--line-deep); }
    nav.g { border-top: 1px solid var(--rule); background: #fff; }
    nav.g .wrap { display: flex; gap: 0 18px; flex-wrap: wrap; font-size: .86rem; min-height: 38px; padding-block: 4px; }
    nav.g a { text-decoration: none; color: var(--text); padding: 6px 0; font-weight: 500; }
    nav.g a:hover { color: var(--brand); }
    main { padding: 28px 0 56px; }
    main.wide { padding-top: 0; }
    h1 { font-family: var(--serif); font-size: 1.7rem; line-height: 1.4; margin: 0 0 14px; color: var(--ink); letter-spacing: .01em; }
    h2 { font-family: var(--serif); font-size: 1.35rem; margin: 44px 0 14px; line-height: 1.45; color: var(--ink); position: relative; padding-bottom: 8px; }
    h2::after { content: ""; position: absolute; left: 0; bottom: 0; width: 44px; height: 3px; background: var(--brand); border-radius: 2px; }
    h2.center { text-align: center; }
    h2.center::after { left: 50%; transform: translateX(-50%); }
    h3 { font-family: var(--serif); font-size: 1.08rem; margin: 22px 0 8px; color: var(--ink); }
    p { margin: 0 0 1em; }
    .eyebrow { display: inline-block; font-size: .78rem; font-weight: 700; color: var(--brand); letter-spacing: .08em; margin-bottom: 4px; }
    .lead { color: var(--muted); font-size: .96rem; }
    .muted { color: var(--muted); }
    .small { font-size: .86rem; }
    .note { font-size: .8rem; color: var(--muted); line-height: 1.6; }
    .crumbs { font-size: .8rem; color: var(--muted); margin-bottom: 14px; }
    .crumbs a { color: var(--muted); }
    .crumbs span { margin: 0 6px; }
    table { border-collapse: collapse; width: 100%; font-size: .92rem; background: #fff; }
    th, td { border-bottom: 1px solid var(--rule); padding: 9px 8px; text-align: left; vertical-align: top; }
    th { background: var(--mist); font-weight: 600; white-space: nowrap; }
    td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .table-wrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: 12px; }
    .table-wrap table { margin: 0; }
    .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    .card { border: 1px solid var(--rule); border-radius: 14px; padding: 16px 18px; background: #fff; box-shadow: 0 6px 20px rgba(20, 50, 40, .05); }
    .card h3 { margin: 0 0 6px; font-size: 1rem; }
    .card a { text-decoration: none; }
    .card .kv { font-size: .88rem; color: var(--muted); line-height: 1.7; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chips a { display: inline-block; padding: 7px 14px; border: 1px solid var(--rule); border-radius: 999px; text-decoration: none; font-size: .9rem; background: #fff; color: var(--text); }
    .chips a:hover { border-color: var(--brand); color: var(--brand); }
    .btn { display: inline-block; padding: 13px 22px; border-radius: 12px; text-decoration: none; font-weight: 700; text-align: center; border: 2px solid transparent; transition: transform .15s, filter .15s; }
    .btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
    .btn.line { background: var(--line-green); color: #fff; }
    .btn.tel { background: #fff; color: var(--ink); border-color: var(--ink); }
    .btn.form { background: var(--cta); color: #fff; }
    .btn.ghost { background: #fff; color: var(--brand); border-color: var(--brand); }
    .btns { display: flex; gap: 10px; flex-wrap: wrap; margin: 12px 0; }
    /* photo tiles */
    .tiles { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .tile { display: grid; grid-template-columns: 96px 1fr; gap: 14px; align-items: start; background: #fff; border: 1px solid var(--rule); border-radius: 14px; padding: 14px; box-shadow: 0 6px 20px rgba(20, 50, 40, .05); }
    .tile img { width: 96px; height: 116px; object-fit: cover; border-radius: 10px; }
    .tile b { display: block; font-family: var(--serif); color: var(--ink); font-size: 1rem; line-height: 1.45; margin-bottom: 4px; }
    .tile b i { font-style: normal; color: var(--cta); }
    .tile p { margin: 0; font-size: .86rem; color: var(--muted); line-height: 1.65; }
    .photo-note { font-size: .72rem; color: var(--muted); text-align: right; margin-top: 6px; }
    /* CTA block */
    .cta { background: var(--mist); border: 1px solid var(--rule); border-radius: 18px; padding: 24px 20px; margin: 36px 0; }
    .cta h2 { margin-top: 0; padding-bottom: 0; }
    .cta h2::after { display: none; }
    .cta-grid { display: grid; gap: 20px; grid-template-columns: 1fr; align-items: start; }
    @media (min-width: 880px) { .cta-grid { grid-template-columns: 1.1fr .9fr; } }
    .cta-photo { display: flex; gap: 12px; align-items: flex-end; margin: 14px 0 0; }
    .cta-photo img { width: 120px; height: 146px; object-fit: cover; border-radius: 12px; box-shadow: 0 6px 18px rgba(20, 50, 40, .12); }
    .cta-photo p { font-size: .86rem; color: var(--muted); margin: 0; }
    .compare { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .compare .card ul { margin: 6px 0 0; padding-left: 1.2em; font-size: .92rem; }
    .compare .card.hi { border-color: var(--brand); background: linear-gradient(180deg, #fff, var(--mist)); }
    .sample-banner { background: #b3261e; color: #fff; text-align: center; font-weight: 700; padding: 8px 12px; font-size: .9rem; }
    .kpi { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin: 12px 0 20px; }
    .kpi div { background: var(--mist); border-radius: 12px; padding: 12px 14px; }
    .kpi b { display: block; font-family: var(--serif); font-size: 1.3rem; color: var(--ink); }
    .kpi span { font-size: .78rem; color: var(--muted); }
    .faq details { border-bottom: 1px solid var(--rule); padding: 12px 0; }
    .faq summary { cursor: pointer; font-weight: 600; }
    .faq details p { margin: 8px 0 0; }
    .prose p { margin-bottom: 1.1em; }
    .prose h2 { margin-top: 32px; }
    .prose ul, .prose ol { padding-left: 1.4em; }
    .prose table { font-size: .9rem; }
    .aside-photo { float: right; width: 140px; margin: 0 0 12px 18px; }
    .aside-photo img { border-radius: 12px; box-shadow: 0 6px 18px rgba(20, 50, 40, .12); }
    .aside-photo small { display: block; font-size: .7rem; color: var(--muted); text-align: right; }
    @media (max-width: 560px) { .aside-photo { width: 110px; margin-left: 12px; } }
    footer.site { border-top: 1px solid var(--rule); background: var(--ink); color: #c9d6d0; padding: 32px 0 44px; font-size: .85rem; }
    footer.site .cols { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    footer.site strong { color: #fff; font-family: var(--serif); }
    footer.site a { color: #dfe8e3; }
    footer.site ul { list-style: none; margin: 6px 0 0; padding: 0; }
    footer.site li { margin: 3px 0; }
    footer.site .note { color: #a9b8b1; }
    .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 8px; padding: 8px 12px; background: rgba(255,255,255,.97); border-top: 1px solid var(--rule); z-index: 10; box-shadow: 0 -6px 20px rgba(0,0,0,.06); }
    .sticky-cta .btn { flex: 1; padding: 11px 6px; font-size: .9rem; border-radius: 10px; }
    @media (min-width: 720px) { .sticky-cta { display: none; } }
    @media (max-width: 719px) {
      main { padding-bottom: 92px; } h1 { font-size: 1.4rem; } .head-tel { display: none; }
      nav.g .wrap { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; gap: 0 16px; }
      nav.g .wrap::-webkit-scrollbar { display: none; }
      nav.g a { white-space: nowrap; }
    }
  </style>
</head>
<body>
  {isSample && <div class="sample-banner">※ サンプルデータ表示中（架空の数値）。実データが入るまで公開しません</div>}
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">金沢の不動産相場・売却<small>{COMPANY.name}｜{COMPANY.license}｜創業1989年</small></a>
      <div class="head-right">
        <a class="head-tel" href={COMPANY.telLink}><b>{COMPANY.tel}</b><small>{COMPANY.hours}</small></a>
        <a class="head-cta" href={COMPANY.line} rel="noopener">LINEで相談</a>
      </div>
    </div>
    <nav class="g" aria-label="主なページ">
      <div class="wrap">
        <a href="/#areas">町名別相場</a>
        <a href="/kaitori/">仲介と買取</a>
        <a href="/guide/">状況別ガイド</a>
        <a href="/results/">実績</a>
        <a href="/faq/">よくある質問</a>
        <a href="/company/">会社概要</a>
        <a href="/contact/">ご相談・査定</a>
      </div>
    </nav>
  </header>
  <main class:list={[{ wide }]}>
    {wide ? <slot /> : <div class="wrap"><slot /></div>}
  </main>
  <footer class="site">
    <div class="wrap">
      <div class="cols">
        <div>
          <strong>{COMPANY.name}</strong>
          <ul>
            <li>代表者：{COMPANY.rep}</li>
            <li>{COMPANY.address}</li>
            <li>TEL：<a href={COMPANY.telLink}>{COMPANY.tel}</a>（{COMPANY.hours}）</li>
            <li>宅地建物取引業免許：{COMPANY.license}</li>
            <li>設立：{COMPANY.founded}</li>
            <li><a href={COMPANY.website} rel="noopener">公式サイト</a>　<a href={COMPANY.line} rel="noopener">公式LINE</a></li>
          </ul>
        </div>
        <div>
          <strong>対象エリア</strong>
          <ul>
            {CITIES.map((c) => <li><a href={`/${c.key}/`}>{c.name}の不動産相場</a></li>)}
          </ul>
        </div>
        <div>
          <strong>ご案内</strong>
          <ul>
            <li><a href="/kaitori/">仲介と当社買取の違い</a></li>
            <li><a href="/guide/">状況別の売却ガイド</a></li>
            <li><a href="/faq/">よくあるご質問</a></li>
            <li><a href="/contact/">ご相談・査定フォーム</a></li>
            <li><a href="/privacy/">プライバシーポリシー</a></li>
          </ul>
          <p class="note" style="margin-top:12px">相場データ：国土交通省 不動産情報ライブラリ（不動産取引価格情報）を当社で集計。最新データ期：{agg.latestPeriodLabel}。更新日：{agg.generatedAt}。サイト内の人物・建物の写真はイメージです。</p>
        </div>
      </div>
      <p class="note" style="margin-top:16px">© {COMPANY.name}</p>
    </div>
  </footer>
  <ExitNudge />
  <div class="sticky-cta" aria-label="ご相談">
    <a class="btn line" href={COMPANY.line} rel="noopener">LINEで相談</a>
    <a class="btn tel" href={COMPANY.telLink}>電話する</a>
    <a class="btn form" href="/contact/">査定を頼む</a>
  </div>
</body>
</html>
